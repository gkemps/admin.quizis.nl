  <script>
    function parseAmount(str) {
      // Accept both comma and dot as decimal separator
      return parseFloat(str.replace(/\./g, '').replace(',', '.')) || 0;
    }

    function formatAmount(num) {
      return num.toFixed(2).replace('.', ',');
    }

    function recalculate() {
      var rows = document.querySelectorAll('#items-body tr');
      var subtotal = 0;

      rows.forEach(function(row) {
        var qtyEl = row.querySelector('[data-role="qty"]');
        var priceEl = row.querySelector('[data-role="price"]');
        var totalEl = row.querySelector('[data-role="line-total"]');

        var qty = parseAmount(qtyEl ? qtyEl.innerText : '1');
        var price = parseAmount(priceEl ? priceEl.innerText : '0');
        var lineTotal = qty * price;

        if (totalEl) {
          totalEl.innerText = formatAmount(lineTotal);
        }
        subtotal += lineTotal;
      });

      var vatPctEl = document.getElementById('vat-pct');
      var vatPct = parseAmount(vatPctEl ? vatPctEl.innerText : '21');
      var vatAmount = subtotal * vatPct / 100;
      var grandTotal = subtotal + vatAmount;

      document.getElementById('subtotal').innerText = formatAmount(subtotal);
      document.getElementById('vat-amount').innerText = formatAmount(vatAmount);
      document.getElementById('grand-total').innerText = formatAmount(grandTotal);
    }

    function addRow() {
      var tbody = document.getElementById('items-body');
      var row = document.createElement('tr');
      row.innerHTML =
        '<td><span contenteditable="true" data-placeholder="Omschrijving">Omschrijving</span></td>' +
        '<td class="text-right"><span contenteditable="true" data-placeholder="1" data-role="qty" oninput="recalculate()">1</span></td>' +
        '<td class="text-right">&euro;&nbsp;<span contenteditable="true" data-placeholder="0,00" data-role="price" oninput="recalculate()">0,00</span></td>' +
        '<td class="text-right font-semibold">&euro;&nbsp;<span data-role="line-total">0,00</span></td>' +
        '<td class="td-actions"><button class="btn btn-remove-row" onclick="removeRow(this)">\u2715</button></td>';
      tbody.appendChild(row);
      recalculate();
    }

    function removeRow(btn) {
      var row = btn.closest('tr');
      row.parentNode.removeChild(row);
      recalculate();
    }

    // Initial calculation
    recalculate();
  </script>

<?php
/** @var \Quiz\Entity\Quiz $quiz */
/** @var \Quiz\Entity\Team[] $teams */

$escape = new Zend\Escaper\Escaper('utf-8');
$cet = new \DateTimeZone('Europe/Amsterdam');
$toCet = function (\DateTime $dt) use ($cet) {
    $d = clone $dt;
    $d->setTimezone($cet);
    return $d;
};
?>

<div class="row">
    <div class="col-md-12">
        <h2>Aangemelde teams: <?php echo $escape->escapeHtml($quiz->getName()); ?></h2>
        <p>
            <strong>Datum:</strong> <?php echo $quiz->getDate()->format('d-m-Y H:i'); ?><br>
            <?php if ($quiz->getLocation()): ?>
                <strong>Locatie:</strong> <?php echo $escape->escapeHtml($quiz->getLocation()->getName()); ?>
                <?php if ($quiz->getLocation()->getCity()): ?>
                    - <?php echo $escape->escapeHtml($quiz->getLocation()->getCity()); ?>
                <?php endif ?>
            <?php endif ?>
        </p>
        
        <a href="<?php echo $this->url('quiz/detail', ['quizId' => $quiz->getId()]); ?>" class="btn btn-default">
            <i class="fa fa-arrow-left"></i> Terug naar quiz
        </a>
    </div>
</div>

<div class="row" style="margin-top: 20px;">
    <div class="col-md-12">
        <?php if (count($teams) > 0): ?>
            <p>
                <strong>Totaal aantal teams:</strong> <?php echo count($teams); ?>
                <?php if ($quiz->getMaxTeams()): ?>
                    / <?php echo $quiz->getMaxTeams(); ?>
                <?php endif ?>
            </p>
            
            <table class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Teamnaam</th>
                        <th>Aanvoerder</th>
                        <th>Email</th>
                        <th>Teamleden</th>
                        <th>Bedrag</th>
                        <th>Betaald</th>
                        <th>Aanmelddatum</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    <?php $counter = 1; ?>
                    <?php foreach ($teams as $team): ?>
                        <tr>
                            <td><?php echo $counter++; ?></td>
                            <td>
                                <strong><?php echo $escape->escapeHtml($team->getName()); ?></strong>
                            </td>
                            <td>
                                <?php echo $team->getCaptain() ? $escape->escapeHtml($team->getCaptain()) : '-'; ?>
                            </td>
                            <td>
                                <?php if ($team->getEmail()): ?>
                                    <a href="mailto:<?php echo $escape->escapeHtml($team->getEmail()); ?>">
                                        <?php echo $escape->escapeHtml($team->getEmail()); ?>
                                    </a>
                                <?php else: ?>
                                    -
                                <?php endif ?>
                            </td>
                            <td class="text-center">
                                <?php
                                    if ($team->getTeamMembers()) {
                                        echo $team->getTeamMembers();
                                    } elseif ($team->getAmount() && $quiz->getPricePerPerson() && $quiz->getPricePerPerson() > 0) {
                                        $calculated = round($team->getAmount() / $quiz->getPricePerPerson());
                                        echo '<span class="text-muted" title="Berekend op basis van betaald bedrag">' . $calculated . '*</span>';
                                    } else {
                                        echo '-';
                                    }
                                ?>
                            </td>
                            <td class="text-right">
                                <?php if ($team->getAmount()): ?>
                                    &euro; <?php echo number_format($team->getAmount(), 2, ',', '.'); ?>
                                <?php else: ?>
                                    -
                                <?php endif ?>
                            </td>
                            <td class="text-center">
                                <?php if ($team->isPaid() && $team->isPaidCash()): ?>
                                    <span class="label label-info">
                                        <i class="fa fa-money"></i> Contant
                                    </span>
                                    <?php if ($team->getDatePaidCash()): ?>
                                        <br><small><?php echo $toCet($team->getDatePaidCash())->format('d-m-Y H:i'); ?></small>
                                    <?php endif ?>
                                <?php elseif ($team->isPaid()): ?>
                                    <span class="label label-success">
                                        <i class="fa fa-credit-card"></i> Online
                                    </span>
                                    <?php if ($team->getDatePaid()): ?>
                                        <br><small><?php echo $toCet($team->getDatePaid())->format('d-m-Y H:i'); ?></small>
                                    <?php endif ?>
                                <?php else: ?>
                                    <span class="label label-warning">
                                        <i class="fa fa-clock-o"></i> Openstaand
                                    </span>
                                <?php endif ?>
                            </td>
                            <td>
                                <?php if ($team->getDateCreated()): ?>
                                    <?php echo $toCet($team->getDateCreated())->format('d-m-Y H:i'); ?>
                                <?php else: ?>
                                    -
                                <?php endif ?>
                            </td>
                            <td>
                                <?php if (!$team->isPaid()): ?>
                                    <?php
                                        // Build amount options based on quiz settings
                                        $amountOptions = [];
                                        $teamMembers = $team->getTeamMembers();

                                        if ($quiz->getPricePerTeam()) {
                                            $amountOptions[number_format($quiz->getPricePerTeam(), 2, '.', '')] =
                                                '&euro;&nbsp;' . number_format($quiz->getPricePerTeam(), 2, ',', '.');
                                        }

                                        if ($quiz->getPricePerPerson()) {
                                            $maxMembers = $quiz->getMaxTeamMembers() ?: 8;
                                            $minMembers = 1;
                                            // If team already has a member count, show that first
                                            if ($teamMembers) {
                                                $total = $quiz->getPricePerPerson() * $teamMembers;
                                                $key = number_format($total, 2, '.', '');
                                                if (!isset($amountOptions[$key])) {
                                                    $amountOptions[$key] = '&euro;&nbsp;' . number_format($total, 2, ',', '.') . ' (' . $teamMembers . 'p)';
                                                }
                                            }
                                            for ($n = $minMembers; $n <= $maxMembers; $n++) {
                                                if ($teamMembers && $n == $teamMembers) {
                                                    continue; // already added above
                                                }
                                                $total = $quiz->getPricePerPerson() * $n;
                                                $key = number_format($total, 2, '.', '');
                                                if (!isset($amountOptions[$key])) {
                                                    $amountOptions[$key] = '&euro;&nbsp;' . number_format($total, 2, ',', '.') . ' (' . $n . 'p)';
                                                }
                                            }
                                        }

                                        // Default if no options from quiz settings
                                        if (empty($amountOptions)) {
                                            $existing = $team->getAmount() ? number_format($team->getAmount(), 2, '.', '') : '0.00';
                                            $amountOptions[$existing] = '&euro;&nbsp;' . number_format((float)$existing, 2, ',', '.');
                                        }
                                    ?>
                                    <div class="btn-group btn-group-xs" role="group">
                                        <?php foreach ($amountOptions as $value => $label): ?>
                                            <form method="post" action="<?php echo $this->url('quiz/detail/teams/team-paid', ['quizId' => $quiz->getId(), 'teamId' => $team->getId()]); ?>" style="display:inline;">
                                                <input type="hidden" name="amount" value="<?php echo $escape->escapeHtmlAttr($value); ?>">
                                                <button type="submit" class="btn btn-success btn-xs" title="Markeer als contant betaald">
                                                    <i class="fa fa-money"></i> <?php echo $label; ?>
                                                </button>
                                            </form>
                                        <?php endforeach ?>
                                    </div>
                                <?php endif ?>
                            </td>
                        </tr>
                    <?php endforeach ?>
                </tbody>
                <tfoot>
                    <tr>
                        <th colspan="4">Totaal</th>
                        <th class="text-center">
                            <?php 
                                $totalMembers = 0;
                                $hasCalculated = false;
                                foreach ($teams as $team) {
                                    if ($team->getTeamMembers()) {
                                        $totalMembers += $team->getTeamMembers();
                                    } elseif ($team->getAmount() && $quiz->getPricePerPerson() && $quiz->getPricePerPerson() > 0) {
                                        $totalMembers += round($team->getAmount() / $quiz->getPricePerPerson());
                                        $hasCalculated = true;
                                    }
                                }
                                if ($totalMembers > 0) {
                                    echo $totalMembers . ($hasCalculated ? '*' : '');
                                } else {
                                    echo '-';
                                }
                            ?>
                        </th>
                        <th class="text-right">
                            <?php 
                                $totalAmount = 0;
                                foreach ($teams as $team) {
                                    if ($team->getAmount()) {
                                        $totalAmount += $team->getAmount();
                                    }
                                }
                                echo $totalAmount > 0 ? '&euro; ' . number_format($totalAmount, 2, ',', '.') : '-';
                            ?>
                        </th>
                        <th colspan="3"></th>
                    </tr>
                </tfoot>
            </table>
            
            <?php 
                $paidTeams = 0;
                foreach ($teams as $team) {
                    if ($team->isPaid()) {
                        $paidTeams++;
                    }
                }
            ?>
            
            <div class="alert alert-info">
                <strong>Status:</strong><br>
                Betaald: <?php echo $paidTeams; ?> teams<br>
                Openstaand: <?php echo (count($teams) - $paidTeams); ?> teams
            </div>
            
        <?php else: ?>
            <div class="alert alert-warning">
                <i class="fa fa-info-circle"></i> Er zijn nog geen teams aangemeld voor deze quiz.
            </div>
        <?php endif ?>
    </div>
</div>

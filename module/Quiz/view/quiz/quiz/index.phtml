<?php
/** @var \Quiz\Entity\Quiz[] $futureQuizzes */
/** @var \Quiz\Entity\Quiz[] $pastQuizzes */
?>

<a href="<?php echo $this->url('quiz/form'); ?>">
    <button class="btn btn-success">
        <i class="fa fa-file-text-o"></i>
        Nieuwe Quiz
    </button>
</a>

<div class="row">
    <div class="col-md-10">
        <!-- Toekomstige quizzen -->
        <h3>Toekomstige quizzen</h3>
        <?php if (count($futureQuizzes) > 0): ?>
            <table class="table table-striped">
                <thead>
                <tr>
                    <th>Datum</th>
                    <th style="width:10px"></th>
                    <th style="width:10px"></th>
                    <th>Naam</th>
                    <th style="width:200px">Voortgang</th>
                    <th>Locatie</th>
                    <th>Teams</th>
                    <th></th>
                </tr>
                </thead>
                <tbody>
                <?php foreach ($futureQuizzes as $quiz): ?>
                    <tr>
                        <td>
                            <?php echo $quiz->getDate()->format('d-m-Y H:i:s'); ?>
                        </td>
                        <td>
                            <?php if ($quiz->isPresentation()): ?>
                                <span class="fa fa-microphone" title="incl. presentatie"></span>
                            <?php endif ?>
                        </td>
                        <td>
                            <?php if ($quiz->isPrivate()): ?>
                                <span class="fa fa-lock" title="prive quiz"></span>
                            <?php endif ?>
                        </td>
                        <td>
                            <a href="<?php echo $this->url('quiz/detail', ['quizId' => $quiz->getId()]); ?>">
                                <?php echo $quiz->getName(); ?>
                                <?php if ($quiz->isLanguageEnUs()): ?>
                                    <span class="label label-info label-as-badge" title="Engels vertaald">
                                        en
                                    </span>
                                <?php endif ?>
                            </a>
                        </td>
                        <td>
                            <?php 
                                $currentQuestions = $quiz->getNumberOfQuestions();
                                $maxQuestions = $quiz->getMaxNumberOfQuestions();
                                $percentage = $maxQuestions > 0 ? round(($currentQuestions / $maxQuestions) * 100) : 0;
                                
                                // Bepaal kleur op basis van voortgang
                                if ($percentage >= 100) {
                                    $progressClass = 'progress-bar-success';
                                } elseif ($percentage >= 75) {
                                    $progressClass = 'progress-bar-info';
                                } elseif ($percentage >= 50) {
                                    $progressClass = 'progress-bar-warning';
                                } else {
                                    $progressClass = 'progress-bar-danger';
                                }
                            ?>
                            <?php if ($maxQuestions > 0): ?>
                                <div class="progress" style="margin-bottom: 0;">
                                    <div class="progress-bar <?php echo $progressClass; ?>" 
                                         role="progressbar" 
                                         aria-valuenow="<?php echo $percentage; ?>" 
                                         aria-valuemin="0" 
                                         aria-valuemax="100" 
                                         style="width: <?php echo $percentage; ?>%; min-width: 35px;">
                                        <?php echo $percentage; ?>%
                                    </div>
                                </div>
                                <small class="text-muted">
                                    <?php echo $currentQuestions; ?> / <?php echo $maxQuestions; ?> vragen
                                </small>
                            <?php endif ?>
                        </td>
                        <td>
                            <?php if (!empty($quiz->getLocation()) && $quiz->getLocation()->getId() != \Quiz\Entity\Location::PRIVATE_LOCATION): ?>
                                <?php echo $quiz->getLocation()->getName(); ?>
                            <?php endif ?>
                        </td>
                        <td>
                            <?php 
                                $teamsCount = $quiz->getRegisteredTeamsCount();
                                $maxTeams = $quiz->getMaxTeams();
                            ?>
                            <?php if ($teamsCount > 0): ?>
                                <a href="<?php echo $this->url('quiz/detail/teams', ['quizId' => $quiz->getId()]); ?>" 
                                   title="Bekijk aangemelde teams">
                                    <span class="label label-info label-as-badge">
                                        <?php echo $teamsCount; ?>
                                        <?php if ($maxTeams): ?>
                                            / <?php echo $maxTeams; ?>
                                        <?php endif ?>
                                        <i class="fa fa-users"></i>
                                    </span>
                                </a>
                            <?php elseif ($maxTeams): ?>
                                <span class="text-muted" title="Nog geen teams aangemeld">
                                    0 / <?php echo $maxTeams; ?>
                                </span>
                            <?php endif ?>
                        </td>
                        <td>
                            <?php if (!empty($quiz->getLocation()) && $quiz->getLocation()->getId() != \Quiz\Entity\Location::PRIVATE_LOCATION): ?>
                                <?php echo $quiz->getLocation()->getCity(); ?>
                            <?php endif ?>
                        </td>
                    </tr>
                <?php endforeach ?>
                </tbody>
            </table>
        <?php else: ?>
            <p class="text-muted">Geen toekomstige quizzen gepland.</p>
        <?php endif; ?>

        <!-- Separator -->
        <div class="quiz-separator"></div>

        <!-- Afgelopen quizzen -->
        <h3>Afgelopen quizzen</h3>
        <?php if (count($pastQuizzes) > 0): ?>
            <table class="table table-striped">
                <thead>
                <tr>
                    <th>Datum</th>
                    <th style="width:10px"></th>
                    <th style="width:10px"></th>
                    <th>Naam</th>
                    <th>Locatie</th>
                    <th></th>
                </tr>
                </thead>
                <tbody>
                <?php foreach ($pastQuizzes as $quiz): ?>
                    <tr>
                        <td>
                            <?php echo $quiz->getDate()->format('d-m-Y H:i:s'); ?>
                        </td>
                        <td>
                            <?php if ($quiz->isPresentation()): ?>
                                <span class="fa fa-microphone" title="incl. presentatie"></span>
                            <?php endif ?>
                        </td>
                        <td>
                            <?php if ($quiz->isPrivate()): ?>
                                <span class="fa fa-lock" title="prive quiz"></span>
                            <?php endif ?>
                        </td>
                        <td>
                            <a href="<?php echo $this->url('quiz/detail', ['quizId' => $quiz->getId()]); ?>">
                                <?php echo $quiz->getName(); ?>
                                <?php if ($quiz->isLanguageEnUs()): ?>
                                    <span class="label label-info label-as-badge" title="Engels vertaald">
                                        en
                                    </span>
                                <?php endif ?>
                            </a>
                        </td>
                        <td>
                            <?php if (!empty($quiz->getLocation()) && $quiz->getLocation()->getId() != \Quiz\Entity\Location::PRIVATE_LOCATION): ?>
                                <?php echo $quiz->getLocation()->getName(); ?>
                            <?php endif ?>
                        </td>
                        <td>
                            <?php if (!empty($quiz->getLocation()) && $quiz->getLocation()->getId() != \Quiz\Entity\Location::PRIVATE_LOCATION): ?>
                                <?php echo $quiz->getLocation()->getCity(); ?>
                            <?php endif ?>
                        </td>
                    </tr>
                <?php endforeach ?>
                </tbody>
            </table>
        <?php else: ?>
            <p class="text-muted">Geen afgelopen quizzen.</p>
        <?php endif; ?>
    </div>
</div>
<script type="text/javascript">
    $(document).ready(function () {
        $(".sortable").sortable({
            update: function (event, ui) {
                var id = $(ui.item).data('quizquestionid');
                var newPos = ui.item.index() + 1;
                $.ajax({
                    url: "/reset-quiz-round-question-number/" + id + "/" + newPos
                });
            }
        });

        // Theme editing functionality
        $('.edit-theme-btn').on('click', function(e) {
            e.preventDefault();
            var roundId = $(this).data('round-id');
            $('#theme-form-' + roundId).slideDown();
            $(this).hide();
        });

        $('.cancel-theme-btn').on('click', function() {
            var roundId = $(this).data('round-id');
            $('#theme-form-' + roundId).slideUp();
            $('.edit-theme-btn[data-round-id="' + roundId + '"]').show();
        });
    });
</script>


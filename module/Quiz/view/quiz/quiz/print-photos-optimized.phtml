<?php
/**
 * Optimized photo printing view with modern layout
 * Uses flexbox-based layout similar to new_project/index.html
 * 
 * Photo distribution and display numbering is handled by the controller
 */
?>
<!DOCTYPE html>
<html lang="nl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><?php echo $this->escapeHtml($quizRound->getQuiz()->getName()); ?> - Foto Ronde</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    :root {
      --primary: #c95a1f;
      --primary-light: #e07a3f;
      --primary-dark: #a04718;
      --text-dark: #4a4a4a;
      --text-light: #ffffff;
      --bg-cream: #fdf8f4;
      --border-light: #e8ddd5;
    }

    @page {
      size: A4 landscape;
      margin: 0;
    }

    @media print {
      body {
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
        margin: 0;
        padding: 0;
      }
      
      html, body {
        height: 210mm;
        overflow: hidden;
      }
    }

    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background: var(--bg-cream);
      color: var(--text-dark);
      margin: 0;
      padding: 0;
    }

    .page {
      width: 297mm;
      height: 210mm;
      padding: 4mm;
      margin: 0;
      background: white;
      display: flex;
      flex-direction: column;
      overflow: hidden;
      box-sizing: border-box;
    }

    /* Header */
    .header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-bottom: 2mm;
      border-bottom: 2px solid var(--primary);
      margin-bottom: 2mm;
      flex-shrink: 0;
    }

    .logo {
      height: 10mm;
    }

    .no-phone-warning {
      display: flex;
      align-items: center;
      gap: 8px;
      background: linear-gradient(135deg, var(--primary), var(--primary-dark));
      color: var(--text-light);
      padding: 6px 16px;
      border-radius: 25px;
      font-weight: 600;
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      box-shadow: 0 2px 8px rgba(201, 90, 31, 0.3);
    }

    .no-phone-icon {
      width: 24px;
      height: 24px;
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .phone-svg {
      width: 18px;
      height: 18px;
    }

    .phone-slash {
      position: absolute;
      width: 26px;
      height: 2px;
      background: var(--text-light);
      transform: rotate(-45deg);
      border-radius: 2px;
    }

    .round-title {
      font-size: 18px;
      font-weight: 700;
      color: var(--primary);
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    /* Photo Grid */
    .photos-container {
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 1.5mm;
      min-height: 0;
      max-height: 145mm;
    }

    .photo-row {
      flex: 1;
      display: flex;
      gap: 1.5mm;
      align-items: stretch;
    }

    .photo-item {
      position: relative;
      border-radius: 4px;
      overflow: hidden;
      box-shadow: 0 2px 8px rgba(0,0,0,0.12);
      border: 2px solid var(--border-light);
      background: #f5f5f5;
    }

    .photo-item img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .photo-number {
      position: absolute;
      top: 6px;
      left: 6px;
      width: 28px;
      height: 28px;
      background: var(--primary);
      color: var(--text-light);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      font-size: 14px;
      box-shadow: 0 2px 6px rgba(0,0,0,0.25);
    }

    /* Questions Section */
    .questions-section {
      flex-shrink: 0;
      margin-top: 1.5mm;
      padding-top: 1.5mm;
      border-top: 2px solid var(--primary);
    }

    .questions-title {
      display: none;
      font-size: 11px;
      font-weight: 700;
      color: var(--primary);
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-bottom: 3mm;
    }

    .questions-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 2mm 4mm;
    }

    .question-item {
      display: flex;
      align-items: center;
      gap: 6px;
      padding: 4px 8px;
      background: var(--bg-cream);
      border-radius: 4px;
      border-left: 3px solid var(--primary);
    }

    .question-num {
      font-weight: 700;
      color: var(--primary);
      font-size: 15px;
      min-width: 22px;
    }

    .question-text {
      font-size: 14px;
      color: var(--text-dark);
      line-height: 1.4;
    }
  </style>
</head>
<body>
  <div class="page">
    <header class="header">
      <img src="<?php echo $this->basePath('img/logo_quizis.png'); ?>" alt="Quizis Logo" class="logo">
      <h1 class="round-title">Foto Ronde</h1>
      <div class="no-phone-warning">
        <div class="no-phone-icon">
          <svg class="phone-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect>
            <line x1="12" y1="18" x2="12" y2="18"></line>
          </svg>
          <div class="phone-slash"></div>
        </div>
        <span>Geen telefoons!</span>
      </div>
    </header>

    <div class="photos-container">
      <?php foreach ($rows as $row): ?>
        <div class="photo-row">
          <?php 
          $totalRatio = 0;
          foreach ($row as $photo) {
            $totalRatio += $photo['width'] / $photo['height'];
          }
          ?>
          <?php foreach ($row as $photo): ?>
            <?php
            $aspectRatio = $photo['width'] / $photo['height'];
            $flexGrow = ($aspectRatio / $totalRatio) * count($row);
            ?>
            <div class="photo-item" style="flex: <?php echo $flexGrow; ?> 1 0;">
              <img src="<?php echo $this->url('media-image', ['questionId' => $photo['question']->getId()]); ?>" 
                   alt="Foto <?php echo $photo['displayNumber']; ?>" loading="lazy">
              <div class="photo-number"><?php echo $photo['displayNumber']; ?></div>
            </div>
          <?php endforeach; ?>
        </div>
      <?php endforeach; ?>
    </div>

    <section class="questions-section">
      <h2 class="questions-title">Wie zijn deze personen?</h2>
      <div class="questions-grid">
        <?php 
        // Create ordered list of photos by displayNumber
        $orderedPhotos = [];
        foreach ($rows as $row) {
            foreach ($row as $photo) {
                $orderedPhotos[] = $photo;
            }
        }
        
        // Split into two columns: 1-5 and 6-10
        $leftColumn = array_slice($orderedPhotos, 0, 5);
        $rightColumn = array_slice($orderedPhotos, 5, 5);
        ?>
        <div>
          <?php foreach ($leftColumn as $photo): ?>
            <div class="question-item">
              <span class="question-num"><?php echo $photo['displayNumber']; ?>.</span>
              <span class="question-text"><?php echo $this->escapeHtml($photo['question']->getQuestion()); ?></span>
            </div>
          <?php endforeach; ?>
        </div>
        <div>
          <?php foreach ($rightColumn as $photo): ?>
            <div class="question-item">
              <span class="question-num"><?php echo $photo['displayNumber']; ?>.</span>
              <span class="question-text"><?php echo $this->escapeHtml($photo['question']->getQuestion()); ?></span>
            </div>
          <?php endforeach; ?>
        </div>
      </div>
    </section>
  </div>

  <script>
    // Toggle object-fit between cover and contain on click
    document.addEventListener('DOMContentLoaded', function() {
      const images = document.querySelectorAll('.photo-item img');
      
      images.forEach(function(img) {
        img.style.cursor = 'pointer';
        
        img.addEventListener('click', function() {
          if (this.style.objectFit === 'contain') {
            this.style.objectFit = 'cover';
          } else {
            this.style.objectFit = 'contain';
          }
        });
      });
    });
  </script>
</body>
</html>
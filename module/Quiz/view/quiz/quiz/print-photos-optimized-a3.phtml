/**
 * A3 photo printing view - 2 pages side-by-side for 2-up printing
 * Photos remain in database order (no resorting)
 * Each page is A4 portrait (210mm × 297mm) so two pages fit on A4 landscape or A3
 */
?>
<!DOCTYPE html>
<html lang="nl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><?php echo $this->escapeHtml($quizRound->getQuiz()->getName()); ?> - Foto Ronde A3</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    :root {
      --primary: #c95a1f;
      --primary-light: #e07a3f;
      --primary-dark: #a04718;
      --text-dark: #4a4a4a;
      --text-light: #ffffff;
      --bg-cream: #fdf8f4;
      --border-light: #e8ddd5;
    }

    @page {
      size: A4 portrait;
      margin: 0;
    }

    @media print {
      body {
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
        margin: 0;
        padding: 0;
      }
    }

    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background: var(--bg-cream);
      color: var(--text-dark);
    }

    .page {
      width: 210mm;
      height: 297mm;
      padding: 3mm;
      margin: 0 auto;
      background: white;
      display: flex;
      flex-direction: column;
      box-shadow: 0 4px 20px rgba(0,0,0,0.1);
